+
+        val tvInfo = view.findViewById<TextView>(R.id.book_info)
+        if (rec != null && rec.lastReadTime > 0L) {
+            tvInfo.text = "最近阅读 ${formatMs(System.currentTimeMillis() - rec.lastReadTime)} · ${book.info}"
+        } else {
