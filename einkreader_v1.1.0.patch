+    private fun tocNextPage() {
+        val totalPages = (tocItems.size + tocPageSize - 1) / tocPageSize
+        if (tocCurrentPage < totalPages - 1) {
+            tocCurrentPage++
+            renderTocPage()
+        }
+    }
