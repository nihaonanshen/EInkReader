+                    })
+                }
+            }
+        } catch (e: Exception) {
+            DebugLog.log(TAG, "listBookmarks failed: ${e.message}")
+        }
+        return result
+    }
+
+    override fun deleteBookmark(fileKey: String, chapterIndex: Int, pageIndex: Int) {
+        if (fileKey.isEmpty()) return
+        try {
+            writableDatabase.delete(
