+        assert_eq!(ch.image_paths, vec!["Images/pic.jpeg"]);
+        // 懒加载内容包含标记
+        let content = load_chapter_content(epub_path.to_str().unwrap(), "Text/ch1.xhtml")
+            .expect("懒加载应成功");
+        assert!(
+            content.contains("[[IMAGE:Images/pic.jpeg]]"),
+            "内容应包含 IMAGE 标记, got: {:?}",
+            content
+        );
+        assert!(content.contains("正文"), "正文文本应保留");
+    }
+}
