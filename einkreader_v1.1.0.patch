+        btnImport.setOnClickListener {
+            startActivityForResult(Intent(this, FilePickerActivity::class.java), 1001)
+        }
+        btnRefreshSettings.setOnClickListener {
+            startActivity(Intent(this, RefreshSettingsActivity::class.java))
+        }
