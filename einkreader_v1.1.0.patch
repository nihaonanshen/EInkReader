-    private fun requestRender() {
-        val now = System.currentTimeMillis()
-        if (lastRenderRequestTime > 0 && now - lastRenderRequestTime < RENDER_COALESCE_MS) {
-            // 快速连续操作：合并刷新，推迟到停顿后显示最终页
