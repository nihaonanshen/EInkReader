+    fun setChapterImages(images: MutableMap<String?, ByteArray?>?) {
+        for (bmp in bitmapCache!!.snapshot().values) {
+            if (bmp != null && !bmp.isRecycled()) bmp.recycle()
+        }
+        bitmapCache!!.evictAll()
