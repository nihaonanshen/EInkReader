+plugins {
+    id "org.jetbrains.kotlin.android" version "1.9.20"
+    id "com.android.application"
+    id "jacoco"
+}
+
+// 本地构建逃生舱：-PEinkBuildOut=<dir> 可把本模块构建目录重定向到别处（供受限环境使用，不影响常规构建）
+def einkBuildOut = findProperty('EinkBuildOut')
+if (einkBuildOut != null) {
+    buildDir = file(einkBuildOut)
+}
+
+android {
+    namespace "com.einkreader"
+    compileSdk 35
+
+    defaultConfig {
+        applicationId "com.einkreader"
+        minSdk 19
+        targetSdk 35
+        versionCode 8
+        versionName "0.0.7"
+        
+        // ✅ [Phase 6] Android 4.4 核心库反编译要求启用 Multidex
+        multiDexEnabled true
+        ndk {
+            // [review-#43] jniLibs 已同时携带 armeabi-v7a 与 arm64-v8a 的
+            // libeinkreader_core.so；旧 abiFilters 只放行 v7a，64 位设备上
+            // 64 位 .so 被打包链路丢掉 → 补齐 arm64-v8a
+            abiFilters 'armeabi-v7a', 'arm64-v8a'
+        }
+        def enableRust = project.hasProperty('enableRust') ? project.enableRust.toBoolean() : true
+        buildConfigField "boolean", "ENABLE_RUST", enableRust ? "true" : "false"
+    }
+
+    signingConfigs {
+        release {
+            // 签名配置：优先读 local.properties（本地构建），其次环境变量（CI）
+            def props = new Properties()
+            def propFile = rootProject.file("local.properties")
+            if (propFile.exists()) {
+                propFile.withInputStream { props.load(it) }
+            }
+            def storeFileVal = props['SIGNING_STORE_FILE'] ?: System.getenv("SIGNING_STORE_FILE") ?: "einkreader.jks"
+            def storePassVal = props['SIGNING_STORE_PASSWORD'] ?: System.getenv("SIGNING_STORE_PASSWORD") ?: ""
+            def keyPassVal = props['SIGNING_KEY_PASSWORD'] ?: System.getenv("SIGNING_KEY_PASSWORD") ?: ""
+            // keystore 位于项目根目录（storeFile 相对路径基于模块目录，需显式用根目录）
+            storeFile rootProject.file(storeFileVal)
+            storePassword storePassVal
+            keyAlias "einkreader"
+            keyPassword keyPassVal
+        }
+    }
+
+    buildTypes {
+        release {
+            signingConfig signingConfigs.release
+            minifyEnabled true
+            shrinkResources true
+            proguardFiles getDefaultProguardFile("proguard-android-optimize.txt"), "proguard-rules.pro"
+        }
+        debug {
+            testCoverageEnabled true
+        }
+    }
+
+    bundle {
+        language {
+            enableSplit = true
+        }
+    }
+
+    compileOptions {
+        coreLibraryDesugaringEnabled true
+        sourceCompatibility JavaVersion.VERSION_1_8
+        targetCompatibility JavaVersion.VERSION_1_8
+    }
+
+    kotlinOptions {
+        jvmTarget = "1.8"
+    }
+
+    buildFeatures {
+        buildConfig true
+        viewBinding true
+    }
+
+    testOptions {
+        unitTests {
+            returnDefaultValues = true
+            all {
+                testLogging {
+                    events "passed", "skipped", "failed", "standardOut"
+                    showExceptions true
+                    showStackTraces true
+                }
+            }
+        }
+    }
+}
+
+jacoco {
+    toolVersion = "0.8.11"
+}
+
+// ===== jacoco 覆盖率报告 + 门禁 =====
+// AGP 的 unit test 覆盖率 exec 由 testCoverageEnabled=true 产出：
+//   app/build/outputs/unit_test_code_coverage/debugUnitTest/testDebugUnitTest.exec
+// jacocoTestReport          —— 生成 HTML/XML 报告（本地调试 / CI 上传 artifact）
+// jacocoCoverageVerification—— CI 门禁：低于阈值的构建直接失败（棘轮式：只升不降）
+def covExecFile = file("$buildDir/outputs/unit_test_code_coverage/debugUnitTest/testDebugUnitTest.exec")
+def covClassDirs = [file("$buildDir/tmp/kotlin-classes/debug")]
+def covSrcDirs = [file("$projectDir/src/main/java")]
+
+task jacocoTestReport(type: JacocoReport) {
+    dependsOn "testDebugUnitTest"
+    mustRunAfter "testDebugUnitTest"
+    executionData = files(covExecFile)
+    classDirectories = files(covClassDirs)
+    sourceDirectories = files(covSrcDirs)
+    reports {
+        xml.required = true
+        html.required = true
+    }
+}
+
+task jacocoCoverageVerification(type: JacocoCoverageVerification) {
+    dependsOn "testDebugUnitTest"
+    mustRunAfter "testDebugUnitTest"
+    executionData = files(covExecFile)
+    classDirectories = files(covClassDirs)
+    sourceDirectories = files(covSrcDirs)
+    // 棘轮基线：2026-10-14 实测 LINE 覆盖率 3.3%（UI 层 Activity/View 未入 Robolectric 测试，
+    // 被测试的是解析器/存储/刷新管理等纯逻辑类）；门禁取 3%（略低于基线容忍波动）。
+    // 后续补测试时调高此值，禁止下调（棘轮只升不降）。
+    violationRules {
+        rule {
+            limit {
+                counter = 'LINE'
+                value = 'COVEREDRATIO'
+                minimum = 0.03
+            }
+        }
+    }
+}
+
+dependencies {
+    implementation "org.jetbrains.kotlin:kotlin-stdlib:1.9.20"
+    // ✅ [Phase 6] Android 4.4 多 dex 支持（EInkReaderApp 继承 MultiDexApplication）
+    implementation "androidx.multidex:multidex:2.0.1"
+    // ✅ [Phase 6] Android 4.4 Java 8+ 核心库反编译支持（Lambda, Stream API等）
+    coreLibraryDesugaring "com.android.tools:desugar_jdk_libs:2.0.3"
+    
+    testImplementation "junit:junit:4.13.2"
+    testImplementation "org.mockito:mockito-core:5.11.0"
+    testImplementation "org.robolectric:robolectric:4.11"
+    testImplementation "com.google.truth:truth:1.1.5"
+    testImplementation "androidx.test:core:1.5.0"
+
+    androidTestImplementation "androidx.test:runner:1.5.2"
+    androidTestImplementation "androidx.test:rules:1.5.0"
+    androidTestImplementation "androidx.test.ext:junit:1.1.5"
+    androidTestImplementation "androidx.test.espresso:espresso-core:3.5.1"
 }
