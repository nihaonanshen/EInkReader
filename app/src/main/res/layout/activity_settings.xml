<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="阅读设置" android:textColor="@android:color/black"
        android:textSize="22sp" android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- 字体大小 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="字体大小" android:textColor="@android:color/black"
        android:textSize="18sp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <TextView android:id="@+id/btn_font_minus"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="A-" android:textColor="@android:color/black"
            android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#FFFFFF"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground" />
        <TextView android:id="@+id/label_text_size"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:text="20" android:textColor="@android:color/black"
            android:textSize="16sp" android:textStyle="bold"
            android:paddingLeft="10dp" android:paddingRight="10dp" />
        <TextView android:id="@+id/btn_font_plus"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="A+" android:textColor="@android:color/black"
            android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#FFFFFF"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 行距 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="行距" android:textColor="@android:color/black"
        android:textSize="18sp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <TextView
            android:id="@+id/btn_line_minus"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="−" android:textColor="@android:color/black"
            android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#FFFFFF"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground" />
        <TextView android:id="@+id/label_line_spacing"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:text="1.40" android:textColor="@android:color/black"
            android:textSize="16sp" android:textStyle="bold"
            android:paddingLeft="10dp" android:paddingRight="10dp" />
        <TextView
            android:id="@+id/btn_line_plus"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="+" android:textColor="@android:color/black"
            android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#FFFFFF"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 段距 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="段距" android:textColor="@android:color/black"
        android:textSize="18sp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <TextView
            android:id="@+id/btn_para_minus"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="−" android:textColor="@android:color/black"
            android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#FFFFFF"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground" />
        <TextView android:id="@+id/label_para_spacing"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:text="1.80" android:textColor="@android:color/black"
            android:textSize="16sp" android:textStyle="bold"
            android:paddingLeft="10dp" android:paddingRight="10dp" />
        <TextView
            android:id="@+id/btn_para_plus"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="+" android:textColor="@android:color/black"
            android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#FFFFFF"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 左右边距 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="左右边距" android:textColor="@android:color/black"
        android:textSize="18sp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <TextView
            android:id="@+id/btn_margin_minus"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="−" android:textColor="@android:color/black"
            android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#FFFFFF"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground" />
        <TextView android:id="@+id/label_horizontal_margin"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:text="10" android:textColor="@android:color/black"
            android:textSize="16sp" android:textStyle="bold"
            android:paddingLeft="10dp" android:paddingRight="10dp" />
        <TextView
            android:id="@+id/btn_margin_plus"
            android:layout_width="44dp" android:layout_height="44dp"
            android:text="+" android:textColor="@android:color/black"
            android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" android:background="#FFFFFF"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackground" />
    </LinearLayout>

        <!-- 首行缩进开关 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="首行缩进" android:textColor="@android:color/black"
                android:textSize="18sp" />
            <Switch android:id="@+id/switch_first_line_indent"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <!-- 字体选择（固定高度：ScrollView 内不可用 weight，且字体可能很多） -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="字体" android:textColor="@android:color/black"
        android:textSize="18sp" android:layout_marginBottom="8dp" />
    <ListView android:id="@+id/font_list"
        android:layout_width="match_parent" android:layout_height="240dp"
        android:divider="@android:color/black"
        android:dividerHeight="1dp" />

    </LinearLayout>

</ScrollView>