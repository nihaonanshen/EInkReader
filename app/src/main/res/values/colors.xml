<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ══════════════════════════════════════════════════════════
         兼容旧引用（值已同步到新色板，避免遗留布局/代码色差）
         ══════════════════════════════════════════════════════════ -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="gray_light">#FFF1EDE3</color>
    <color name="gray_dark">#FF4A4A4A</color>
    <color name="primary">#FF1F1F1F</color>
    <color name="primary_dark">#FF161616</color>
    <color name="accent">#FF6B6B6B</color>
    <color name="text_primary">#FF1F1F1F</color>
    <color name="text_secondary">#FF6B6B6B</color>
    <color name="bg_light">#FFF3EDE3</color>

    <!-- ══════════════════════════════════════════════════════════
         设计令牌 · 暖纸色调（日间）
         ntx_6sl 屏幕为暖纸底色（KOReader 同思路），对比度略低于纯黑纯白，
         长时间阅读更柔和；卡片用纯白 surface 与纸色背景形成层次。
         ══════════════════════════════════════════════════════════ -->
    <color name="background">#FFFAF6EF</color>   <!-- 全局暖纸背景 -->
    <color name="surface">#FFFFFFFF</color>       <!-- 卡片/面板表面 -->
    <color name="surface_muted">#FFF3EDE3</color> <!-- 顶栏/底栏/分组卡内嵌 -->
    <color name="ink">#FF1F1F1F</color>           <!-- 主文字（替代纯黑） -->
    <color name="ink_soft">#FF4A4A4A</color>      <!-- 次级强调文字 -->
    <color name="ink_muted">#FF6B6B6B</color>     <!-- 辅助/弱化文字 -->
    <color name="border">#FFE6DFD1</color>        <!-- 卡片描边 -->
    <color name="border_strong">#FFCCC2AF</color>
    <color name="divider">#FFECE5D8</color>       <!-- 行间分隔线 -->
    <color name="progress_track">#FFDDD5C6</color>
    <color name="progress_fill">#FF1F1F1F</color>
    <color name="cover_epub">#FFE7E0D2</color>    <!-- EPUB 占位封面底色 -->
    <color name="cover_txt">#FFF0EBE1</color>     <!-- TXT 占位封面底色 -->
    <color name="placeholder_ink">#FF7A7060</color>

    <!-- ══════════════════════════════════════════════════════════
         夜间（运行时 prefs 切换，代码用 *_night 系列）
         黑底不用纯黑 #000，用 #161616 更柔和、避免 E-ink 残影过重
         ══════════════════════════════════════════════════════════ -->
    <color name="background_night">#FF161616</color>
    <color name="surface_night">#FF1F1F1F</color>
    <color name="surface_muted_night">#FF262626</color>
    <color name="ink_night">#FFC9C9C9</color>
    <color name="ink_soft_night">#FFA8A8A8</color>
    <color name="ink_muted_night">#FF8A8A8A</color>
    <color name="border_night">#FF333333</color>
    <color name="divider_night">#FF2A2A2A</color>
    <color name="progress_track_night">#FF3A3A3A</color>
    <color name="progress_fill_night">#FFC9C9C9</color>
    <color name="cover_epub_night">#FF2E2A22</color>
    <color name="cover_txt_night">#FF292929</color>
    <color name="placeholder_ink_night">#FF9A907E</color>
</resources>
